datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum UserRole {
  USER
  ADMIN
  SUPERADMIN
}

model User {
  id                   String               @id @default(auto()) @map("_id") @db.ObjectId
  name                 String
  role                 UserRole             @default(USER)
  email                String               @unique
  password             String?
  emailVerified        DateTime?
  image                String?
  createdAt            DateTime             @default(now())
  updatedAt            DateTime             @updatedAt
  info                 UserInfo?
  accounts             Account[]
  sessions             Session[]
  posts                Post[]
  comments             PostComment[]
  postLikes            PostLike[]
  problems             Problem[]
  problemSets          ProblemSet[]
  problemSetProgresses ProblemSetProgress[]
  problemLikes         ProblemLike[]
  problemSetLikes      ProblemSetLike[]
  problemStars         ProblemStar[]
  endorsements         ProblemEndorsement[]
  teamMemberships      TeamMembership[]
  teamInvites          TeamInvite[]         @relation("user")
  teamInvitesSent      TeamInvite[]         @relation("InviteSender")
  teams                Team[]
}

model UserInfo {
  id     String  @id @default(auto()) @map("_id") @db.ObjectId
  userId String  @unique @db.ObjectId
  user   User    @relation(fields: [userId], references: [id])
  // Required for SUPERADMIN users when they endorse a problem
  rank   String?
}

// ----------- Begin authentication models -----------
model Account {
  id                String  @id @default(auto()) @map("_id") @db.ObjectId
  userId            String  @db.ObjectId
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.String
  access_token      String? @db.String
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.String
  session_state     String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(auto()) @map("_id") @db.ObjectId
  sessionToken String   @unique
  userId       String   @db.ObjectId
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model VerificationToken {
  id         String   @id @default(auto()) @map("_id") @db.ObjectId
  identifier String
  token      String
  expires    DateTime

  @@unique([identifier, token])
}

// ----------- End authentication models -----------

// -------------------- Post Models --------------------
model Post {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  title       String
  content     String
  wordCount   Int?
  slug        String   @unique
  publishedAt DateTime @default(now())
  authorId    String   @db.ObjectId
  author      User     @relation(fields: [authorId], references: [id])
  updatedAt   DateTime @updatedAt

  comments PostComment[]
  likes    PostLike[]
  views    Int           @default(0)
}

model PostComment {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  content   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  authorId  String   @db.ObjectId
  postId    String   @db.ObjectId

  author User       @relation(fields: [authorId], references: [id])
  post   Post       @relation(fields: [postId], references: [id])
  likes  PostLike[] // If you allow likes on comments too
}

model PostLike {
  id        String  @id @default(auto()) @map("_id") @db.ObjectId
  userId    String  @db.ObjectId
  postId    String? @db.ObjectId
  commentId String? @db.ObjectId

  user    User         @relation(fields: [userId], references: [id])
  post    Post?        @relation(fields: [postId], references: [id])
  comment PostComment? @relation(fields: [commentId], references: [id])
}

// -------------------- End Post Models --------------------

// -------------------- Go Problem Models --------------------
model Counter {
  id    String @id @default(auto()) @map("_id") @db.ObjectId
  model String @unique
  value Int    @default(0)
}

model Problem {
  id                 String              @id @default(auto()) @map("_id") @db.ObjectId
  num                String              @unique
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  authorId           String              @db.ObjectId
  description        String?
  rank               Int                 @default(-10)
  initial            String
  correct            String
  visibility         Visibility          @default(PUBLIC)
  problemStats       ProblemStats?
  problemSetProblems ProblemSetProblem[]
  submissions        Submission[]
  author             User                @relation(fields: [authorId], references: [id])
  endorsement        ProblemEndorsement?
  problemLikes       ProblemLike[]
  problemStars       ProblemStar[]
  teamProblems       TeamProblem[]

  @@index([authorId])
}

model ProblemStats {
  id              String  @id @default(auto()) @map("_id") @db.ObjectId
  problemNum      String  @unique
  problem         Problem @relation(fields: [problemNum], references: [num])
  views           Int     @default(0)
  submissionCount Int     @default(0)
  correctCount    Int     @default(0)
}

model ProblemLike {
  id         String  @id @default(auto()) @map("_id") @db.ObjectId
  userId     String  @db.ObjectId
  problemNum String
  user       User    @relation(fields: [userId], references: [id])
  problem    Problem @relation(fields: [problemNum], references: [num])
}

model ProblemStar {
  id         String   @id @default(auto()) @map("_id") @db.ObjectId
  userId     String   @db.ObjectId
  problemNum String
  createdAt  DateTime @default(now())

  user    User    @relation(fields: [userId], references: [id])
  problem Problem @relation(fields: [problemNum], references: [num])

  @@unique([userId, problemNum])
}

enum SubmissionStatus {
  solved
  mismatch
  partial
}

// Join table between ProblemSet and Problem for problemNumefficient queries
// Position is the Default position of the problem in the set (e.g., 1, 2, ...)
model ProblemSetProblem {
  id            String     @id @default(auto()) @map("_id") @db.ObjectId
  problemSetNum String
  problemNum    String
  position      Int
  problem       Problem    @relation(fields: [problemNum], references: [num])
  problemSet    ProblemSet @relation(fields: [problemSetNum], references: [num])
  createdAt     DateTime   @default(now())

  @@unique([problemSetNum, problemNum])
}

model ProblemSet {
  id                   String               @id @default(auto()) @map("_id") @db.ObjectId
  num                  String               @unique
  name                 String
  description          String
  authorId             String               @db.ObjectId
  problemCount         Int                  @default(0)
  averageRank          Float                @default(0)
  createdAt            DateTime             @default(now())
  updatedAt            DateTime             @updatedAt
  visibility           Visibility           @default(PUBLIC)
  author               User                 @relation(fields: [authorId], references: [id])
  problemSetProblems   ProblemSetProblem[]
  problemSetProgresses ProblemSetProgress[]
  problemSetStats      ProblemSetStats?
  problemSetLikes      ProblemSetLike[]
  teamProblemSets      TeamProblemSet[]

  @@index([authorId]) // Find how many problem sets a user has created
}

model ProblemSetStats {
  id            String     @id @default(auto()) @map("_id") @db.ObjectId
  problemSetNum String     @unique
  views         Int        @default(0)
  attempted     Int        @default(0)
  completed     Int        @default(0)
  problemSet    ProblemSet @relation(fields: [problemSetNum], references: [num])
}

model ProblemSetLike {
  id            String     @id @default(auto()) @map("_id") @db.ObjectId
  userId        String     @db.ObjectId
  problemSetNum String
  user          User       @relation(fields: [userId], references: [id])
  problemSet    ProblemSet @relation(fields: [problemSetNum], references: [num])
}

model Submission {
  id                   String              @id @default(auto()) @map("_id") @db.ObjectId
  userId               String              @db.ObjectId
  problemNum           String
  problemSetProgressId String?             @db.ObjectId
  userMoves            Json
  status               SubmissionStatus
  mismatchIndex        Int
  correctOpponentMove  Json?
  problem              Problem             @relation(fields: [problemNum], references: [num])
  progress             ProblemSetProgress? @relation(fields: [problemSetProgressId], references: [id])
  createdAt            DateTime            @default(now())
}

enum ProgressStatus {
  completed
  abandoned
  inprogress
}

model ProblemSetProgress {
  id            String          @id @default(auto()) @map("_id") @db.ObjectId
  userId        String          @db.ObjectId
  problemSetNum String
  status        ProgressStatus?
  problemOrder  Json
  currentIndex  Int?
  problemSet    ProblemSet      @relation(fields: [problemSetNum], references: [num])
  user          User            @relation(fields: [userId], references: [id])
  submissions   Submission[]
  updatedAt     DateTime        @updatedAt
  createdAt     DateTime        @default(now())

  @@index([userId, problemSetNum]) // Common lookup for doing problem sets
}

enum Visibility {
  PUBLIC
  TEAM
  PRIVATE
  DELETED
}

model ProblemEndorsement {
  id         String   @id @default(auto()) @map("_id") @db.ObjectId
  problemNum String
  userId     String   @db.ObjectId
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  problem Problem @relation(fields: [problemNum], references: [num])
  user    User    @relation(fields: [userId], references: [id])

  @@unique([problemNum]) // Only one endorsement per problem
}

// -------------------- End Go Problem Models --------------------

// -------------------- Team models --------------------
model Team {
  id          String     @id @default(auto()) @map("_id") @db.ObjectId
  slug        String
  name        String
  description String?
  status      TeamStatus @default(ACTIVE)
  ownerId     String     @db.ObjectId
  owner       User       @relation(fields: [ownerId], references: [id])
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  memberships     TeamMembership[]
  invites         TeamInvite[]
  teamProblems    TeamProblem[]
  teamProblemSets TeamProblemSet[]

  @@unique([slug])
}

enum TeamStatus {
  ACTIVE
  INACTIVE
  DELETED
}

model TeamProblem {
  id         String   @id @default(auto()) @map("_id") @db.ObjectId
  teamSlug   String
  team       Team     @relation(fields: [teamSlug], references: [slug])
  problemNum String
  problem    Problem  @relation(fields: [problemNum], references: [num])
  createdAt  DateTime @default(now())

  @@unique([teamSlug, problemNum])
}

model TeamProblemSet {
  id            String     @id @default(auto()) @map("_id") @db.ObjectId
  teamSlug      String
  team          Team       @relation(fields: [teamSlug], references: [slug])
  problemSetNum String
  problemSet    ProblemSet @relation(fields: [problemSetNum], references: [num])
  createdAt     DateTime   @default(now())

  @@unique([teamSlug, problemSetNum])
}

model TeamMembership {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  userId    String   @db.ObjectId
  teamSlug  String
  role      TeamRole @default(MEMBER)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id])
  team      Team     @relation(fields: [teamSlug], references: [slug])

  @@unique([userId, teamSlug]) // no duplicate membership
}

enum TeamRole {
  OWNER
  ADMIN
  MEMBER
}

model TeamInvite {
  id          String       @id @default(auto()) @map("_id") @db.ObjectId
  teamSlug    String
  userId      String       @db.ObjectId // invitee
  createdById String       @db.ObjectId // inviter
  type        InviteType
  status      InviteStatus @default(PENDING)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  team      Team @relation(fields: [teamSlug], references: [slug])
  user      User @relation("user", fields: [userId], references: [id])
  createdBy User @relation("InviteSender", fields: [createdById], references: [id])

  @@index([userId])
  @@index([createdById])
}

enum InviteType {
  REQUEST
  INVITE
}

enum InviteStatus {
  PENDING
  ACCEPTED
  DECLINED
}

// -------------------- End of Team models --------------------
