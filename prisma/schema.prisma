datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum UserRole {
  USER
  ADMIN
}

model User {
  id            String    @id @default(auto()) @map("_id") @db.ObjectId
  name          String
  role          UserRole  @default(USER)
  email         String    @unique
  password      String?
  emailVerified DateTime?
  image         String?
  accounts      Account[]
  sessions      Session[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  posts                Post[]
  comments             Comment[]
  likes                Like[]
  problems             Problem[]
  problemSets          ProblemSet[]
  problemSetProgresses ProblemSetProgress[]
  teamMemberships      TeamMembership[]

  TeamInvite TeamInvite[]
}

// ----------- Begin authentication models -----------
model Account {
  id                String  @id @default(auto()) @map("_id") @db.ObjectId
  userId            String  @db.ObjectId
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.String
  access_token      String? @db.String
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.String
  session_state     String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(auto()) @map("_id") @db.ObjectId
  sessionToken String   @unique
  userId       String   @db.ObjectId
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model VerificationToken {
  id         String   @id @default(auto()) @map("_id") @db.ObjectId
  identifier String
  token      String
  expires    DateTime

  @@unique([identifier, token])
}

// ----------- End authentication models -----------

// -------------------- Post Models --------------------
model Post {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  title       String
  content     String
  wordCount   Int?
  slug        String   @unique
  publishedAt DateTime @default(now())
  authorId    String   @db.ObjectId
  author      User     @relation(fields: [authorId], references: [id])
  updatedAt   DateTime @updatedAt

  comments Comment[]
  likes    Like[]
  views    Int       @default(0)
}

model Comment {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  content   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  authorId  String   @db.ObjectId
  postId    String   @db.ObjectId

  author User   @relation(fields: [authorId], references: [id])
  post   Post   @relation(fields: [postId], references: [id])
  likes  Like[] // If you allow likes on comments too
}

model Like {
  id        String  @id @default(auto()) @map("_id") @db.ObjectId
  userId    String  @db.ObjectId
  postId    String? @db.ObjectId
  commentId String? @db.ObjectId

  user    User     @relation(fields: [userId], references: [id])
  post    Post?    @relation(fields: [postId], references: [id])
  comment Comment? @relation(fields: [commentId], references: [id])
}

// -------------------- End Post Models --------------------

// -------------------- Go Problem Models --------------------

model Problem {
  id                 String              @id @default(auto()) @map("_id") @db.ObjectId
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  authorId           String              @db.ObjectId
  description        String?
  rank               Int                 @default(-10)
  initial            Json
  correct            Json
  visibility         Visibility          @default(PRIVATE)
  problemStats       ProblemStats?
  problemSetProblems ProblemSetProblem[]
  submissions        Submission[]
  author             User                @relation(fields: [authorId], references: [id])
  teamIds            String[]            @db.ObjectId
  teams              Team[]              @relation(fields: [teamIds], references: [id])

  @@index([authorId])
}

model ProblemStats {
  id              String  @id @default(auto()) @map("_id") @db.ObjectId
  problemId       String  @unique @db.ObjectId
  problem         Problem @relation(fields: [problemId], references: [id])
  likes           Int     @default(0)
  views           Int     @default(0)
  submissionCount Int     @default(0)
  correctCount    Int     @default(0)
}

enum SubmissionStatus {
  solved
  mismatch
  partial
}

// Join table between ProblemSet and Problem for efficient queries
// Position is the Default position of the problem in the set (e.g., 1, 2, ...)
model ProblemSetProblem {
  id           String     @id @default(auto()) @map("_id") @db.ObjectId
  problemSetId String     @db.ObjectId
  problemId    String     @db.ObjectId
  position     Int
  problem      Problem    @relation(fields: [problemId], references: [id])
  problemSet   ProblemSet @relation(fields: [problemSetId], references: [id])
  createdAt    DateTime   @default(now())

  @@unique([problemSetId, problemId])
}

model ProblemSet {
  id                   String               @id @default(auto()) @map("_id") @db.ObjectId
  name                 String
  description          String
  authorId             String               @db.ObjectId
  problemCount         Int                  @default(0)
  averageRank          Float                @default(0)
  createdAt            DateTime             @default(now())
  updatedAt            DateTime             @updatedAt
  visibility           Visibility           @default(PRIVATE)
  author               User                 @relation(fields: [authorId], references: [id])
  problemSetProblems   ProblemSetProblem[]
  problemSetProgresses ProblemSetProgress[]
  problemSetStats      ProblemSetStats?
  teamIds              String[]             @db.ObjectId
  teams                Team[]               @relation(fields: [teamIds], references: [id])

  @@index([authorId]) // Find how many problem sets a user has created
}

model ProblemSetStats {
  id           String     @id @default(auto()) @map("_id") @db.ObjectId
  problemSetId String     @unique @db.ObjectId
  problemSet   ProblemSet @relation(fields: [problemSetId], references: [id])
  likes        Int        @default(0)
  views        Int        @default(0)
  attempted    Int        @default(0)
  completed    Int        @default(0)
}

model Submission {
  id                   String              @id @default(auto()) @map("_id") @db.ObjectId
  userId               String              @db.ObjectId
  problemId            String              @db.ObjectId
  problemSetProgressId String?             @db.ObjectId
  userMoves            Json
  status               SubmissionStatus
  mismatchIndex        Int
  correctOpponentMove  Json?
  problem              Problem             @relation(fields: [problemId], references: [id])
  progress             ProblemSetProgress? @relation(fields: [problemSetProgressId], references: [id])
  createdAt            DateTime            @default(now())
}

enum ProgressStatus {
  completed
  abandoned
  inprogress
}

model ProblemSetProgress {
  id           String          @id @default(auto()) @map("_id") @db.ObjectId
  userId       String          @db.ObjectId
  problemSetId String          @db.ObjectId
  status       ProgressStatus?
  problemOrder Json
  currentIndex Int?
  problemSet   ProblemSet      @relation(fields: [problemSetId], references: [id])
  user         User            @relation(fields: [userId], references: [id])
  submissions  Submission[]
  updatedAt    DateTime        @updatedAt
  createdAt    DateTime        @default(now())

  @@index([userId, problemSetId]) // Common lookup for doing problem sets
}

enum Visibility {
  PUBLIC
  TEAM
  PRIVATE
}

// -------------------- End Go Problem Models --------------------

// -------------------- Team models --------------------
model Team {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  name        String
  description String? // optional or required, up to you
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  memberships   TeamMembership[]
  invites       TeamInvite[]
  problemSetIds String[]         @db.ObjectId
  problemSets   ProblemSet[]     @relation(fields: [problemSetIds], references: [id])
  problemIds    String[]         @db.ObjectId
  problems      Problem[]        @relation(fields: [problemIds], references: [id])
}

model TeamMembership {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  userId    String   @db.ObjectId
  teamId    String   @db.ObjectId
  role      TeamRole
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id])
  team      Team     @relation(fields: [teamId], references: [id])

  @@unique([userId, teamId]) // no duplicate membership
}

enum TeamRole {
  OWNER
  ADMIN
  MEMBER
}

model TeamInvite {
  id        String       @id @default(auto()) @map("_id") @db.ObjectId
  teamId    String       @db.ObjectId
  userId    String       @db.ObjectId
  role      TeamRole
  status    InviteStatus @default(PENDING)
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt
  team      Team         @relation(fields: [teamId], references: [id])
  user      User         @relation(fields: [userId], references: [id])

  @@unique([userId, teamId]) // no duplicate invite
}

enum InviteStatus {
  PENDING
  ACCEPTED
  DECLINED
}

// -------------------- End of Team models --------------------
